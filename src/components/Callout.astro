---
interface Props {
    type?: "info" | "warn" | "comment";
}

const { type = "info" } = Astro.props;

const config = {
    info: {
        container:
            "bg-teal-50 border-teal-200 text-teal-950 dark:bg-teal-950/30 dark:border-teal-800 dark:text-teal-50",
        icon: "ℹ️",
        title: "Note",
    },
    warn: {
        container:
            "bg-amber-50 border-amber-400 text-amber-900 dark:bg-amber-950/30 dark:border-amber-800 dark:text-amber-200",
        icon: "⚠️",
        title: "Warning",
    },
    comment: {
        container:
            "bg-pink-50 border-pink-200 text-fuchsia-950 dark:bg-pink-950/30 dark:border-pink-800 dark:text-fuchsia-100",
        icon: "💬",
        title: "Comment",
    },
};

const style = config[type];
---

<blockquote
    class:list={[
        "overflow-auto not-prose my-8 border-l-4 p-6 text-sm/6",
        style.container,
    ]}
>
    <div class="-mt-2 -ml-4 mr-2 flex items-center gap-2">
        <span class="text-xl select-none" aria-hidden="true">{style.icon}</span>
        <span class="font-bold uppercase tracking-wide text-xs"
            >{style.title}</span
        >
    </div>

    <slot />

</blockquote>