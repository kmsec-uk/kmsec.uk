---
import { Image } from "astro:assets";

interface Props {
  src: any;
  caption: string;
}
const { src, caption = "" } = Astro.props;
---

<figure
  class="mx-auto w-fit gap-0 break-inside-avoid grid justify-stretch rounded-sm border border-stone-700"
>
  <Image
    src={src}
    alt={caption}
    class="rounded-t-sm border-stone-900 dark:border-stone-900"
  />
  {
    caption && (
      <figcaption class="p-1 mt-0 rounded-b-sm border-t border-stone-900 text-center bg-stone-700 dark:bg-stone-700 text-sm text-stone-300 italic">
        {caption}
      </figcaption>
    )
  }
</figure>
