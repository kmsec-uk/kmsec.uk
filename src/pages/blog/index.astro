---
import Heading from "~/components/Heading.astro";
import Layout from "~/layouts/Layout.astro";
import Main from "~/layouts/Main.astro";
import {posts, months} from "~/collections"


function fmtDate(date: Date): string {
    return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`
}

---

<Layout title="All blog posts">
    <Main title="All blog posts">
        <p>Unfortunately I end up going down intel rabbit holes more than writing about them. Please enjoy the rare fruits of my endeavours.</p>
        <ul class="my-12 grid gap-y-12">
            {posts.map(post => 
                <li class="group rounded-xs outline-offset-4 hover:outline-1 hover:outline-sky-300">
                    <a 
                    href={"/blog/" + post.id}
                    >
                        <Heading as="h2" class="group-hover:text-sky-600 group-hover:dark:text-sky-300 font-semibold">{post.data.title}</Heading>
                        <p class="text-sm italic"><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time> | Tags: {post.data.tags.join(", ")}</p>
                        <p class="my-2">{post.data.description}</p>
                    </a>
                </li>
            )}
        </ul>
    </Main>
</Layout>